---
/**
 * @file Fixed site header: logo, current-layer chip, desktop nav pill and mobile menu.
 *
 * It also renders the thin scroll progress bar. Used by Layout.astro on every page; the behaviour
 * (compact mode, active link, mobile menu) lives in header.ts, which finds these elements by id and
 * class.
 */

import { getLangFromUrl, useTranslations } from '@i18n/utils';
import Logo from '@components/layout/Logo.astro';
import LayerChip from '@components/layout/header/LayerChip.astro';
import DesktopNav from '@components/layout/header/DesktopNav.astro';
import MobileMenu from '@components/layout/header/MobileMenu.astro';
import { localizePath } from '@lib/urls';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The logo link keeps the URL form it has always had (no trailing slash in English, the bare base
// in Spanish), so existing links and analytics keep matching.
const homeUrl = lang === 'en' ? localizePath(lang).replace(/\/$/, '') : import.meta.env.BASE_URL;

// Section links shown in the nav. `label` doubles as the section id on the home page.
const navItems = [
  { title: t('nav.about'), label: 'sobre-mi', url: localizePath(lang, 'sobre-mi') },
  { title: t('nav.stack'), label: 'stack', url: localizePath(lang, 'stack') },
  { title: t('nav.experience'), label: 'experiencia', url: localizePath(lang, 'experiencia') },
  { title: t('nav.projects'), label: 'proyectos', url: localizePath(lang, 'proyectos') },
  { title: t('nav.contact'), label: 'contacto', url: localizePath(lang, 'contacto') },
];

// The CV is a separate page, not a section of the home, so it is shown outside the section pill.
const cvItem = { title: t('nav.cv'), label: 'cv', url: localizePath(lang, 'cv') };
---

{/* Thin bar at the top of the screen that fills as the page is scrolled (driven by header.ts). */}
<div id="scroll-progress" aria-hidden="true"></div>

<header
  id="site-header"
  class="fixed top-0 z-50 flex items-center justify-between w-full px-4 md:px-8 py-4"
>
  {
    /* Mobile glass bar. It is a separate element, not a style on <header>: a backdrop-filter on an
     ancestor would become the containing block of the fixed full-screen menu inside and make it smaller. */
  }
  <div id="header-bar" class="header-bar glass rounded-b-2xl md:hidden" aria-hidden="true"></div>

  <div class="flex items-center gap-4 z-50">
    <a href={homeUrl} aria-label="Home" class="site-logo flex items-center z-50">
      <Logo class="w-10 h-10 md:w-12 md:h-12" />
    </a>

    {/* Name of the pipeline layer in view (desktop, home page only). */}
    <LayerChip />
  </div>

  {/* Desktop navigation: the section pill stays centred; the CV button sits to its right. */}
  <DesktopNav navItems={navItems} cvItem={cvItem} />

  <MobileMenu navItems={navItems} cvItem={cvItem} />
</header>

<script>
  // `astro:page-load` fires on the first load and after every ClientRouter navigation, so the
  // header behaviour is bound again each time the new page's markup is in place.
  import { initHeader } from '@components/layout/header/header';

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  /* Slides the header in when the page appears. */
  header {
    animation: header-appear 0.5s ease-out;
  }

  @keyframes header-appear {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Scaled horizontally from 0 to 1 by header.ts (a transform is cheap to animate). */
  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 100%;
    height: 2px;
    background: var(--layer-accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  /* Logo shrinks towards its left edge in compact mode (see #site-header.is-compact below). */
  .site-logo {
    transform-origin: left center;
    transition: transform 0.3s ease;
  }

  .site-logo {
    color: var(--layer-text);
  }

  .site-logo :global(svg) {
    transition: transform 0.3s ease;
  }

  .site-logo:hover :global(svg) {
    transform: scale(1.08);
  }

  /* Mobile glass bar: appears once the page scrolls so titles do not run under the logo. */
  .header-bar {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-top-width: 0;
    background: rgba(14, 16, 20, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* header.ts adds `is-scrolled` once the page has scrolled a few pixels. */
  #site-header.is-scrolled .header-bar {
    opacity: 1;
  }

  /* header.ts adds `is-compact` after scrolling a little further. */
  #site-header.is-compact .site-logo {
    transform: scale(0.85);
  }
</style>
