---
import { Icon } from 'astro-icon/components';
// import LanguagePicker from '@components/ui/LanguagePicker.astro'; // Desactivado temporalmente
import type { NavItem } from '@components/layout/header/types';

interface Props {
  navItems: NavItem[];
  cvItem: NavItem;
}

const { navItems, cvItem } = Astro.props;
---

<div id="desktop-bar" class="hidden md:grid">
  <nav id="desktop-nav" class="glass flex" aria-label="Principal">
    <span id="nav-drop" aria-hidden="true"></span>
    {
      navItems.map((link) => (
        <a
          class="nav-link desktop-link"
          href={link.url}
          data-section={link.label}
          data-nav={link.label}
        >
          {link.title}
        </a>
      ))
    }
    <!-- Selector de idioma desactivado temporalmente -->
    <!-- <div class="h-6 w-px bg-gray-700 mx-2"></div>
    <LanguagePicker /> -->
  </nav>
  <a class="nav-link cv-pill glass" href={cvItem.url} data-section="" data-nav={cvItem.label}>
    <Icon name="tabler:file-cv" size={16} aria-hidden="true" />
    {cvItem.title}
  </a>
</div>

<style>
  /* Desktop bar: spans the header so the pill is truly centered (middle column) and the CV
     button hugs its right edge (last column). Only the pill and the button take clicks. */
  #desktop-bar {
    position: absolute;
    left: 0;
    right: 0;
    grid-template-columns: 1fr auto 1fr;
    pointer-events: none;
  }

  #desktop-bar > * {
    pointer-events: auto;
  }

  /* Desktop pill */
  #desktop-nav {
    position: relative;
    grid-column: 2;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: transform 0.3s ease;
  }

  /* Compact: scale (compositor only) instead of animating padding. */
  :global(#site-header.is-compact) #desktop-nav {
    transform: scale(0.92);
  }

  /* CV button: its own small glass pill, as tall as the section pill. */
  .cv-pill {
    grid-column: 3;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 0.5rem;
    padding-inline: 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--layer-text);
    transform-origin: left center;
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.3s ease;
  }

  .cv-pill:hover {
    color: var(--layer-accent);
  }

  .cv-pill[aria-current='page'] {
    color: var(--color-lava);
    border-color: color-mix(in srgb, var(--color-lava) 55%, transparent);
  }

  :global(#site-header.is-compact) .cv-pill {
    transform: scale(0.92);
  }

  #nav-drop {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0;
    width: 0;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2);
    opacity: 0;
    pointer-events: none;
  }

  .desktop-link {
    position: relative;
    z-index: 1;
    padding: 0.5rem 0.875rem;
    border-radius: 9999px;
    white-space: nowrap;
    color: var(--layer-text);
    transition: color 0.25s ease;
  }

  .desktop-link:hover,
  .desktop-link[aria-current='true'] {
    color: var(--layer-accent);
  }
</style>
