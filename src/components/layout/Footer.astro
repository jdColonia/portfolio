---
/**
 * @file Site footer: name, social links, email, CV link and copyright.
 *
 * Used by Layout.astro on every page. On desktop it is a compact strip between the side docks that
 * shares the last screen with the contact section. The `data-track*` attributes are picked up by
 * the click listener in @lib/analytics.
 */

import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { SITE_CONFIG, SOCIAL_LINKS } from '@data/config';
import { localizePath } from '@lib/urls';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const cvPage = localizePath(lang, 'cv');
---

<footer class="site-footer site-footer-zone">
  <div class="footer-inner mx-auto w-full max-w-7xl px-4 md:px-6 lg:px-8">
    <div class="footer-top">
      <p class="footer-name">Juan David Colonia Aldana</p>

      <nav aria-label={t('footer.links')}>
        <ul class="footer-links">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track="contact_click"
                  data-track-method={link.name.toLowerCase()}
                  data-track-location="footer"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              data-track="contact_click"
              data-track-method="email"
              data-track-location="footer"
            >
              {SITE_CONFIG.email}
            </a>
          </li>
          <li>
            <a
              href={cvPage}
              data-track="cv_open"
              data-track-cv-language={lang}
              data-track-location="footer"
            >
              {t('nav.cv')}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} {SITE_CONFIG.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
    color: var(--layer-muted);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-top {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 0.95;
    color: var(--layer-text);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
    font-size: 1rem;
  }

  @media (min-width: 768px) {
    .footer-links {
      align-items: flex-end;
    }
  }

  .footer-links a {
    display: inline-block;
    padding-block: 0.375rem;
    overflow-wrap: anywhere;
    color: var(--layer-text);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--layer-accent);
  }

  .footer-bottom {
    display: flex;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--layer-muted) 30%, transparent);
    font-size: 0.8125rem;
  }

  /* Desktop: a compact centred footer between the side docks, with a fixed height (--footer-h,
     defined in global.css). The extra .site-footer-zone class overrides the stacked mobile layout
     above. */
  @media (min-width: 1024px) {
    .site-footer-zone {
      height: var(--footer-h);
      padding: 0 var(--dock-w);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    .site-footer-zone .footer-inner {
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0 0 1rem;
      text-align: center;
    }

    .site-footer-zone .footer-top {
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      padding-bottom: 0.625rem;
    }

    .site-footer-zone .footer-name {
      font-size: 1.75rem;
    }

    .site-footer-zone .footer-links {
      flex-flow: row wrap;
      align-items: baseline;
      justify-content: center;
      gap: 0 1.25rem;
      font-size: 0.8125rem;
    }

    .site-footer-zone .footer-links a {
      padding-block: 0.125rem;
    }

    .site-footer-zone .footer-bottom {
      justify-content: center;
      padding-top: 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>
