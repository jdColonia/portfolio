---
/**
 * @file The 3D crystal's wrapper (Layout.astro renders it on the home page only).
 *
 * It holds a canvas for the live three.js scene and an SVG isometric cube. The SVG is both the
 * placeholder shown while the 3D code downloads and the static fallback when WebGL is unavailable,
 * motion is reduced, the viewport is small or the visitor has data saving on. crystal-mount.ts
 * decides which one is visible through the `data-crystal` attribute below. The cube has three
 * visible faces, each a 3x3 grid of small cells.
 */

// Isometric projection constants: S is the edge length of a cell in SVG units and COS is cos(30
// degrees), the horizontal factor of an isometric axis.
const S = 28;
const COS = 0.866;
// 2D vectors of the three isometric axes: ex goes right and down, ey goes left and down, ez goes
// straight down.
const ex = { x: COS * S, y: 0.5 * S };
const ey = { x: -COS * S, y: 0.5 * S };
const ez = { x: 0, y: S };

type Point = { x: number; y: number };
// Returns a + b * k.
const add = (a: Point, b: Point, k = 1): Point => ({ x: a.x + b.x * k, y: a.y + b.y * k });
const toPoints = (pts: Point[]) => pts.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ');

// Every cell as an SVG polygon: its points and its opacity. The opacity differs per face (top,
// left, right) to fake lighting.
const cells: { points: string; opacity: number }[] = [];
for (let a = 0; a < 3; a++) {
  for (let b = 0; b < 3; b++) {
    // Top face (spans ex and ey)
    const t0 = add(add({ x: 0, y: 0 }, ex, a), ey, b);
    cells.push({
      points: toPoints([t0, add(t0, ex), add(add(t0, ex), ey), add(t0, ey)]),
      opacity: 0.95,
    });
    // Left face (spans ex and down)
    const l0 = add(add(add({ x: 0, y: 0 }, ey, 3), ex, a), ez, b);
    cells.push({
      points: toPoints([l0, add(l0, ex), add(add(l0, ex), ez), add(l0, ez)]),
      opacity: 0.6,
    });
    // Right face (spans ey and down)
    const r0 = add(add(add({ x: 0, y: 0 }, ex, 3), ey, a), ez, b);
    cells.push({
      points: toPoints([r0, add(r0, ey), add(add(r0, ey), ez), add(r0, ez)]),
      opacity: 0.35,
    });
  }
}
---

{
  /*
  `transition:persist` keeps this element (and so the WebGL canvas) alive across ClientRouter
  navigations instead of recreating it. It is decorative, hence aria-hidden.
*/
}
<div id="crystal-root" aria-hidden="true" data-crystal="loading" transition:persist="crystal">
  <div id="crystal-glow"></div>
  <canvas id="crystal-canvas"></canvas>
  <svg id="crystal-fallback" viewBox="-80 -6 160 180" fill="none" stroke-linejoin="round">
    {
      cells.map((cell) => (
        <polygon
          points={cell.points}
          stroke="var(--layer-tint)"
          stroke-width="1.2"
          stroke-opacity={cell.opacity}
          fill="var(--layer-tint)"
          fill-opacity={cell.opacity * 0.08}
        />
      ))
    }
  </svg>
</div>

<style>
  /* On mobile the box covers the whole viewport. On desktop it is a box 45% of the viewport wide
     that slides between "stages", chosen by html[data-stage] (set by lib/motion as the visitor
     scrolls): right, left, or centred (larger and dimmed). The stage 'none' fades the crystal out
     at every width, for sections that use the full width. Only the box's transform and opacity
     animate; the canvas inside keeps its size, so it is never re-rendered while moving.
     pointer-events is off so the crystal never blocks clicks on the page. */
  #crystal-root {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.6s;
  }

  @media (min-width: 1024px) {
    #crystal-root {
      inset: 0 auto auto 0;
      width: 45vw;
      height: 100svh;
      /* Start at the right side: 55% of the viewport width to the right of the left edge.
         --vw is the viewport width without the scrollbar (set in Layout.astro). */
      transform: translateX(calc(var(--vw, 100vw) * 0.55));
      will-change: transform;
      transition:
        transform 0.9s cubic-bezier(0.65, 0, 0.35, 1),
        opacity 0.6s;
    }

    :global(html[data-stage='right']) #crystal-root {
      transform: translateX(calc(var(--vw, 100vw) * 0.55));
    }

    :global(html[data-stage='left']) #crystal-root {
      transform: translateX(0);
    }

    /* 27.5% is (100% - 45%) / 2: the offset that centres the 45%-wide box on the screen. */
    :global(html[data-stage='center']) #crystal-root {
      transform: translateX(calc(var(--vw, 100vw) * 0.275)) scale(1.3);
      opacity: 0.45;
    }
  }

  :global(html[data-stage='none']) #crystal-root {
    opacity: 0;
  }

  /* A soft radial glow behind the canvas. Its colour follows the tint of the active layer and
     fades between layers because --glow-color is a registered <color> property (see global.css). */
  #crystal-glow {
    position: absolute;
    inset: 0;
    --glow-color: var(--layer-tint);
    background: radial-gradient(
      circle closest-side,
      color-mix(in srgb, var(--glow-color) 18%, transparent),
      transparent
    );
    transition: --glow-color 0.6s;
  }

  /* The data-crystal attribute (set by crystal-mount.ts) decides what is visible:
     - loading: the SVG placeholder is shown (pulsing on desktop) and the canvas is hidden.
     - ready: the canvas fades in and the SVG fades out and stops animating.
     - fallback: only the static SVG is shown and the canvas is removed from the layout. */
  #crystal-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.6s;
  }

  #crystal-root[data-crystal='ready'] #crystal-canvas {
    opacity: 1;
  }

  #crystal-root[data-crystal='fallback'] #crystal-canvas {
    display: none;
  }

  #crystal-fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(70vw, 360px);
    height: auto;
    transform: translate(-50%, -50%);
    opacity: 0.2;
    transition: opacity 0.6s;
  }

  #crystal-root[data-crystal='ready'] #crystal-fallback {
    opacity: 0;
    animation: none;
  }

  @media (min-width: 1024px) {
    #crystal-fallback {
      width: min(30vw, 440px);
      opacity: 1;
    }
  }

  /* Below the desktop breakpoint a canvas only exists if the window was resized from a larger
     size; it is kept faint so it does not compete with the content. */
  @media (max-width: 1023px) {
    #crystal-root[data-crystal='ready'] #crystal-canvas {
      opacity: 0.2;
    }
  }

  /* Slow fade in and out of the placeholder, to show that something is loading. */
  @keyframes crystal-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.8;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    #crystal-root[data-crystal='loading'] #crystal-fallback {
      animation: crystal-pulse 1.6s ease-in-out infinite;
    }
  }
</style>

<script>
  // Hooks the mount logic into ClientRouter's lifecycle: pause the render loop just before the page
  // is swapped, release the WebGL context after the swap if the new page has no crystal, and
  // re-check what to show on every page load.
  import {
    desktopQuery,
    onDesktopChange,
    pauseCrystal,
    releaseDetachedCrystal,
    sync,
  } from '@components/crystal/crystal-mount';

  document.addEventListener('astro:before-swap', pauseCrystal);
  document.addEventListener('astro:after-swap', releaseDetachedCrystal);
  document.addEventListener('astro:page-load', sync);

  // Resized or rotated past the desktop breakpoint: the crystal may mount now.
  desktopQuery.addEventListener('change', onDesktopChange);
</script>
