---
// Projects section: a horizontal row of project cards, grouped by track (data, software,
// platform) with a divider card before each group. The same markup has three behaviours, chosen
// by gallery.ts and exposed as `data-mode` on the .gallery element:
//   - no `data-mode` (reduced motion): a native, swipeable horizontal scroll with snap points;
//   - `pinned` (desktop): the section is held in place while scrolling moves the cards sideways;
//   - `sticky` (phones and tablets): the cards stick with CSS while scrolling moves them sideways.
// The data-gallery-* attributes below are the hooks gallery.ts uses to find each part.
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import ProjectCard from '@components/sections/projects/ProjectCard.astro';
import TrackDivider from '@components/sections/projects/TrackDivider.astro';
import { projects, type ProjectTrack } from '@data/projects';
import TitleSection from '@components/ui/TitleSection.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Translation keys for each track's heading and one-line description.
const trackKeys = {
  data: { label: 'projects.track.data', desc: 'projects.track.data.desc' },
  software: { label: 'projects.track.software', desc: 'projects.track.software.desc' },
  platform: { label: 'projects.track.platform', desc: 'projects.track.platform.desc' },
} as const;

// Display order of the tracks. A track without projects is dropped.
const trackOrder: ProjectTrack[] = ['data', 'software', 'platform'];
const groups = trackOrder
  .map((track) => ({ track, items: projects[lang].filter((project) => project.track === track) }))
  .filter((group) => group.items.length > 0);
---

<div class="gallery" data-gallery>
  <div class="gallery-pin" data-gallery-pin>
    <div class="projects-intro">
      <TitleSection path="gold.proyectos">{t('section.projects')}</TitleSection>
      <p class="projects-lead">{t('projects.intro')}</p>
    </div>

    {/* gallery-scroll and gallery-stage are only used in sticky mode (see the styles below). */}
    <div class="gallery-scroll" data-gallery-scroll>
      <div class="gallery-stage" data-gallery-stage>
        {
          /* tabindex="0" lets keyboard users scroll the row natively; gallery.ts removes it when
            it takes over the scrolling. */
        }
        <div
          class="gallery-viewport"
          data-gallery-viewport
          role="region"
          aria-label={t('section.projects')}
          tabindex="0"
        >
          <div class="gallery-track" data-gallery-track>
            {
              groups.map((group) => (
                <Fragment>
                  <TrackDivider
                    label={t(trackKeys[group.track].label)}
                    description={t(trackKeys[group.track].desc)}
                  />

                  {group.items.map((project) => (
                    <ProjectCard project={project} lang={lang} />
                  ))}
                </Fragment>
              ))
            }
          </div>
        </div>

        <div class="gallery-progress" aria-hidden="true"><span data-gallery-bar></span></div>
      </div>
    </div>
  </div>
</div>

<style>
  .projects-intro {
    padding-inline: var(--gallery-pad);
    margin-bottom: 2rem;
  }

  .projects-intro :global(.title-section) {
    margin-bottom: 1rem;
  }

  .projects-lead {
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--layer-muted);
  }

  /* ---- Base styles: a full-bleed native carousel with snap points. This is what small screens
     and users with reduced motion get; the other modes below build on it. ---------------- */
  /* Full-bleed: --vw is the viewport width without the scrollbar (set in Layout.astro), and the
     negative margin pulls the gallery out of the padded <main>. */
  .gallery {
    --gallery-pad: 1rem;
    position: relative;
    width: var(--vw, 100vw);
    margin-left: calc(50% - var(--vw, 100vw) / 2);
  }

  @media (min-width: 768px) {
    .gallery {
      --gallery-pad: 1.5rem;
    }
  }

  .gallery-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0.5rem;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gallery-pad);
    scrollbar-width: thin;
    scrollbar-color: var(--layer-muted) transparent;
  }

  .gallery-track {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 1rem;
    width: max-content;
    padding-inline: var(--gallery-pad);
  }

  .gallery-progress {
    height: 2px;
    margin: 1.25rem var(--gallery-pad) 0;
    overflow: hidden;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
  }

  .gallery-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--layer-tint);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* ---- Desktop: this section uses stage 'none', so the 3D crystal is hidden and the gallery
     can use the full width between the side docks, showing about three cards at once. ------ */
  @media (min-width: 1024px) {
    .gallery {
      --gallery-pad: 0px;
      --card-w: clamp(19rem, 26vw, 25rem);
      width: 100%;
      margin-left: 0;
    }

    /* The section wrapper has no vertical padding here (it uses `section-flush`), so this
       element supplies it, including the space that clears the fixed header. */
    .gallery-pin {
      padding: 5.5rem 0 2.5rem;
    }

    .projects-intro {
      margin-bottom: 1.25rem;
    }

    .projects-lead {
      max-width: 64ch;
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .gallery-track {
      gap: 1.5rem;
    }

    .gallery-progress {
      margin-top: 1rem;
    }
  }

  /* Pinned mode (desktop, motion allowed), switched on by gallery.ts: the title and the cards fill
     exactly one screen, which is held in place while the page scrolls. The scroll "scrubs" the
     track sideways, meaning its position follows the scrollbar. Native horizontal scrolling and
     snapping are turned off because the script moves the track itself. */
  .gallery[data-mode='pinned'] .gallery-pin {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100svh;
    padding: 5.5rem 0 2.5rem;
  }

  .gallery[data-mode='pinned'] .gallery-viewport {
    overflow-x: clip;
    overflow-y: visible;
    padding-bottom: 0;
    scroll-snap-type: none;
  }

  .gallery[data-mode='pinned'] .gallery-track {
    will-change: transform;
  }

  /* Sticky mode (phones and tablets, motion allowed). Only the cards stay in view, using CSS
     `position: sticky` instead of a JavaScript pin, because a JS pin can make native momentum
     scrolling on touch screens jump. The title scrolls away above them. The stage is only as
     tall as the cards and sticks centered below the header (--stage-top, set by gallery.ts).
     The surrounding .gallery-scroll box is as tall as the stage plus the horizontal travel,
     which gives the stage room to stay stuck while the cards move sideways. */
  .gallery[data-mode='sticky'] .gallery-stage {
    position: sticky;
    top: var(--stage-top, 4.5rem);
    padding-top: 1.5rem;
  }

  .gallery[data-mode='sticky'] .gallery-viewport {
    overflow-x: clip;
    overflow-y: visible;
    padding-bottom: 0;
    scroll-snap-type: none;
  }

  .gallery[data-mode='sticky'] .gallery-track {
    will-change: transform;
  }

  .gallery[data-mode='sticky'] .gallery-progress {
    margin-top: 1rem;
  }
</style>

<script>
  import { initGallery } from '@components/sections/projects/gallery';

  // Fires on the first load and after every client-side navigation (ClientRouter).
  document.addEventListener('astro:page-load', initGallery);
</script>
