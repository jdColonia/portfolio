---
/**
 * @file "About" section: portrait, three short text blocks and the compact metrics row.
 *
 * The text paragraphs are revealed line by line when they scroll into view (script at the bottom).
 */

import { Image } from 'astro:assets';
import { getLangFromUrl } from '@i18n/utils';
import { SITE_CONFIG } from '@data/config';
import meImg from '@assets/me.png';
import { manifesto } from '@data/manifesto';
import TitleSection from '@components/ui/TitleSection.astro';
import Metrics from '@components/sections/about/Metrics.astro';

const lang = getLangFromUrl(Astro.url);
const c = manifesto[lang];
---

<div class="about">
  <div class="about-head">
    <TitleSection path={c.path}>{c.heading}</TitleSection>

    <div class="about-photo">
      <Image
        src={meImg}
        alt={SITE_CONFIG.name}
        width={192}
        height={192}
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <div class="about-blocks">
    {
      c.blocks.map((block) => (
        <div class="about-block">
          <h3 class="about-title">{block.title}</h3>
          <p class="manifesto-text">{block.text}</p>
        </div>
      ))
    }
  </div>

  <Metrics compact />
</div>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .about-head :global(.title-section) {
    min-width: 0;
    margin-bottom: 0;
  }

  /* The photo is turned black and white and then tinted with the current layer colour: the ::after
     overlay below uses `mix-blend-mode: color`. The `isolation` rule keeps that blending inside
     the photo instead of mixing with the page behind it. */
  .about-photo {
    position: relative;
    isolation: isolate;
    flex: none;
    width: 96px;
    height: 96px;
    overflow: hidden;
    border-radius: 50%;
  }

  .about-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(1);
  }

  .about-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--layer-tint);
    mix-blend-mode: color;
    opacity: 0.35;
    pointer-events: none;
  }

  .about-blocks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .about-block {
    padding-top: 0.875rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .about-title {
    margin-bottom: 0.5rem;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--layer-text);
  }

  .manifesto-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--layer-muted);
  }

  @media (min-width: 768px) {
    .about-blocks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  /* Desktop: the whole section must fit in one screen, so spacing and type are tighter. */
  @media (min-width: 1024px) {
    .about {
      gap: 1.5rem;
    }

    .about-blocks {
      column-gap: 1.25rem;
    }

    .about-block {
      padding-top: 0.75rem;
    }

    .manifesto-text {
      font-size: 0.8125rem;
      line-height: 1.55;
    }
  }

  @media (min-width: 1440px) {
    .about {
      gap: 2rem;
    }

    .about-blocks {
      column-gap: 1.5rem;
    }

    .manifesto-text {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // GSAP is the animation library; ScrollTrigger starts animations based on scroll position and
  // SplitText splits text into lines so each one can be animated separately.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import { onDestroy, prefersReducedMotion } from '@lib/motion';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  // `astro:page-load` fires on the first load and after every client-side navigation
  // (ClientRouter), so the animation is rebuilt each time and reverted through `onDestroy`.
  document.addEventListener('astro:page-load', () => {
    const paragraphs = gsap.utils.toArray<HTMLElement>('.manifesto-text');
    if (paragraphs.length === 0 || prefersReducedMotion()) return;

    // Each paragraph plays once: its lines slide up from behind a mask (a box with hidden overflow
    // wrapper per line) as the paragraph reaches 90% of the viewport height. `autoSplit` re-splits
    // the text if a resize changes where the lines wrap, and `onSplit` rebuilds the tween then.
    const ctx = gsap.context(() => {
      paragraphs.forEach((paragraph) => {
        SplitText.create(paragraph, {
          type: 'lines',
          mask: 'lines',
          autoSplit: true,
          onSplit: (self) =>
            gsap.from(self.lines, {
              yPercent: 100,
              duration: 0.9,
              stagger: 0.08,
              ease: 'expo.out',
              scrollTrigger: { trigger: paragraph, start: 'top 90%', once: true },
            }),
        });
      });
    });

    onDestroy(() => ctx.revert());
  });
</script>
