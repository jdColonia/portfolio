---
/**
 * @file Transition screen between sections: a large word that scales up as the user scrolls until
 * it fills the view, with an orange glow behind it.
 *
 * While scrolling, the section is pinned (held in place with CSS `position: sticky`) and the scroll
 * progress drives the zoom; with reduced motion it is just a heading. The animation script is at
 * the bottom of this file.
 */

import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The zoom is centered on one letter "a" of the word, so that letter is what ends up filling the
// stage. The search starts at 40% of the word so a letter in its middle or later part is picked;
// if there is no "a" there, the first letter is used.
const word = t('zoom.word');
const pivotAt = Math.max(0, word.indexOf('a', Math.floor(word.length * 0.4)));
const before = word.slice(0, pivotAt);
const pivot = word.charAt(pivotAt);
const after = word.slice(pivotAt + 1);
---

<section class="zoom" data-layer="gold" data-stage="center" data-zoom>
  <div class="zoom-pin" data-zoom-pin>
    <div class="zoom-stage">
      <div class="zoom-glow" data-zoom-glow aria-hidden="true"></div>
      <h2 class="zoom-word" data-zoom-word>
        {before}<span data-zoom-pivot>{pivot}</span>{after}
      </h2>
    </div>
  </div>
</section>

<style>
  /* Full-bleed: break out of the padded <main> so the section spans the whole viewport width.
     --vw is the viewport width without the scrollbar (set in Layout.astro), so the section
     never causes horizontal overflow. */
  .zoom {
    position: relative;
    width: var(--vw, 100vw);
    margin-left: calc(50% - var(--vw, 100vw) / 2);
  }

  /* Default styles, which are also what users with reduced motion get: a plain heading block. */
  .zoom-pin {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 6rem;
    overflow: clip;
  }

  .zoom-stage {
    position: relative;
    display: grid;
    width: 100%;
    place-items: center;
  }

  .zoom-glow {
    display: none;
  }

  .zoom-word {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 16vw, 8rem);
    font-weight: 400;
    line-height: 0.95;
    white-space: nowrap;
    text-align: center;
    color: var(--layer-text);
  }

  /* Desktop: the zoom spans the full width between the two side docks. The 3D crystal is centered
     and dimmed behind it. (The mask at the end of this style block fades the stage's edges.) */
  @media (min-width: 1024px) {
    .zoom {
      width: calc(var(--vw, 100vw) - 2 * var(--dock-w));
      margin-left: var(--dock-w);
    }

    .zoom-word {
      font-size: clamp(3.5rem, 8vw, 7rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* 150svh: one screen for the pinned stage plus half a screen of extra scrolling, which is the
       distance over which the zoom plays. */
    .zoom {
      height: 150svh;
    }

    /* The inner element stays fixed in view while the section scrolls past. The zoom is
       "scrubbed", meaning its progress follows that scroll. */
    .zoom-pin {
      position: sticky;
      top: 0;
      height: 100svh;
      padding-block: 0;
    }

    .zoom-stage {
      height: 100%;
      overflow: clip;
    }

    /* The orange glow is painted once at full size and only its transform and opacity change
       while scrolling, which the browser can animate cheaply (no repaint on every frame). */
    .zoom-glow {
      display: block;
      position: absolute;
      top: 50%;
      left: 50%;
      width: 70vmax;
      height: 70vmax;
      margin: -35vmax 0 0 -35vmax;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 54, 33, 0.35), transparent 60%);
      opacity: 0;
      transform: scale(0.4);
      will-change: transform, opacity;
      pointer-events: none;
    }

    .zoom-word {
      will-change: transform, opacity;
    }
  }
  /* Desktop with motion: fade the stage out over its left and right 2.5rem, so the scaled word
     and the glow do not end abruptly at the stage's clipped edges. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .zoom-stage {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        #000 2.5rem,
        #000 calc(100% - 2.5rem),
        transparent
      );
      mask-image: linear-gradient(
        to right,
        transparent,
        #000 2.5rem,
        #000 calc(100% - 2.5rem),
        transparent
      );
    }
  }
</style>

<script>
  // GSAP is the animation library; ScrollTrigger ties animations to the scroll position.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { onDestroy, prefersReducedMotion } from '@lib/motion';

  gsap.registerPlugin(ScrollTrigger);

  // `astro:page-load` fires on the first load and after every client-side navigation
  // (ClientRouter), so the animation is recreated each time and reverted through `onDestroy`.
  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector<HTMLElement>('[data-zoom]');
    const glow = section?.querySelector<HTMLElement>('[data-zoom-glow]');
    const word = section?.querySelector<HTMLElement>('[data-zoom-word]');
    const pivot = section?.querySelector<HTMLElement>('[data-zoom-pivot]');
    if (!section || !glow || !word || !pivot || prefersReducedMotion()) return;

    const ctx = gsap.context(() => {
      // Scale the word around the centre of the pivot letter, so that letter grows in place and
      // ends up filling the stage. The origin is stored as a percentage so it survives window
      // resizes; it is recomputed when the fonts load and on every ScrollTrigger refresh, since
      // both can change the letter widths.
      const setOrigin = () => {
        const width = word.offsetWidth;
        if (width <= 0) return;
        const center = pivot.offsetLeft + pivot.offsetWidth / 2;
        word.style.transformOrigin = `${(center / width) * 100}% 50%`;
      };
      setOrigin();
      void document.fonts?.ready.then(setOrigin);

      // One timeline of 1 unit, spread over the whole scroll of the section (150svh). The word
      // scales up, and fades out between 0.5 and 0.8, before it gets huge. The glow grows, fades
      // in over the first 0.4 and fades out again from 0.6. The stage clips whatever grows past
      // its edges.
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
          onRefresh: setOrigin,
        },
      });

      tl.fromTo(word, { scale: 1 }, { scale: 5, duration: 1, ease: 'power2.in' }, 0)
        .to(word, { opacity: 0, duration: 0.3 }, 0.5)
        .fromTo(glow, { scale: 0.4 }, { scale: 2.5, duration: 1 }, 0)
        .fromTo(glow, { opacity: 0 }, { opacity: 1, duration: 0.4 }, 0)
        .to(glow, { opacity: 0, duration: 0.4 }, 0.6);
    }, section);

    onDestroy(() => ctx.revert());
  });
</script>
