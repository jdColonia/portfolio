---
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { SITE_CONFIG } from '@data/config';
import { Icon } from 'astro-icon/components';
import Badge from '@components/ui/Badge.astro';
import HeroName from '@components/sections/hero/HeroName.astro';
import Button from '@components/ui/Button.astro';
import SocialLinks from '@components/ui/SocialLinks.astro';
import { localizePath, withBase } from '@lib/urls';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cvUrl = withBase((lang === 'es' ? SITE_CONFIG.cvEs : SITE_CONFIG.cvEn).slice(1));
const projectsUrl = localizePath(lang, 'proyectos');
---

<div class="hero">
  <div class="hero-badge">
    <Badge>
      {t('hero.badge')}
    </Badge>
  </div>

  <HeroName />

  <div class="hero-body">
    <h2 class="hero-fade hero-role" style="--d:0">
      {t('hero.subtitle')}
    </h2>

    <p class="hero-fade hero-tagline" style="--d:1">
      {t('hero.tagline')}
    </p>

    <p class="hero-fade hero-description" style="--d:2">
      {t('hero.description')}
    </p>

    <div class="hero-fade hero-actions" style="--d:3">
      <Button href={projectsUrl} data-section="proyectos" class="nav-link">
        {t('hero.cta-projects')}
      </Button>
      <Button
        href={cvUrl}
        download
        variant="glass"
        data-track="cv_download"
        data-track-cv-language={lang}
        data-track-location="hero"
      >
        <Icon slot="icon" name="tabler:download" size={24} />
        {t('hero.download-cv')}
      </Button>

      <SocialLinks class="hero-socials" linkClass="hero-social-link" location="hero" />
    </div>
  </div>
</div>

<style>
  .hero {
    padding-top: 2rem;
  }

  .hero-badge {
    margin-bottom: 1.25rem;
  }

  .hero-body {
    max-width: 60ch;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: 0;
    }

    /* Centered cover screen: everything is centered on the page axis. */
    .hero {
      text-align: center;
    }

    .hero-badge {
      display: flex;
      justify-content: center;
    }

    .hero-body {
      max-width: 100%;
    }
  }

  .hero-role {
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--layer-text);
    margin-bottom: 0.25rem;
  }

  .hero-tagline {
    font-size: 1.0625rem;
    color: var(--layer-muted);
    margin-bottom: 0.75rem;
  }

  .hero-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--layer-muted);
    margin-bottom: 1.5rem;
  }

  /* At most three lines. */
  @media (min-width: 1024px) {
    .hero-description {
      max-width: 60ch;
      margin-inline: auto;
      font-size: 0.875rem;
      line-height: 1.6;
    }
  }

  @media (min-width: 1440px) {
    .hero-description {
      font-size: 0.9375rem;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-actions :global(.hero-socials) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
    list-style: none;
  }

  .hero-actions :global(.hero-social-link) {
    display: inline-flex;
    padding: 0.5rem;
    color: var(--layer-muted);
    transition: color 0.2s ease;
  }

  /* The fixed left dock carries the social links on desktop. */
  @media (min-width: 1024px) {
    .hero-actions :global(.hero-socials) {
      display: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  .hero-actions :global(.hero-social-link:hover) {
    color: var(--layer-accent);
  }

  /* CSS-only intro (starts at first paint, no JS): the badge and the body fade up (the name's
     chars rise in HeroName). Reduced motion shows everything at once. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-badge {
      animation: hero-badge-in 0.7s cubic-bezier(0.215, 0.61, 0.355, 1) both;
    }

    .hero-fade {
      animation: hero-fade-in 0.8s cubic-bezier(0.215, 0.61, 0.355, 1) both;
      animation-delay: calc(0.65s + var(--d, 0) * 0.1s);
    }

    @keyframes hero-badge-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }

    @keyframes hero-fade-in {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
    }
  }
</style>

<script>
  import { initHero } from '@components/sections/hero/hero';

  document.addEventListener('astro:page-load', initHero);
</script>
