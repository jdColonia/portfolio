---
/**
 * @file First screen of the home page: status badge, the big name (HeroName), subtitle, short
 * description and the main buttons.
 *
 * The intro animation is pure CSS so it starts at first paint; hero.ts adds the scroll effect on
 * the name. On desktop the content is centered.
 */

import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { SITE_CONFIG } from '@data/config';
import { Icon } from 'astro-icon/components';
import Badge from '@components/ui/Badge.astro';
import HeroName from '@components/sections/hero/HeroName.astro';
import Button from '@components/ui/Button.astro';
import SocialLinks from '@components/ui/SocialLinks.astro';
import { localizePath, withBase } from '@lib/urls';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// SITE_CONFIG stores the CV paths with a leading slash; withBase() expects them without it.
const cvUrl = withBase((lang === 'es' ? SITE_CONFIG.cvEs : SITE_CONFIG.cvEn).slice(1));
const projectsUrl = localizePath(lang, 'proyectos');
---

<div class="hero">
  <div class="hero-badge">
    <Badge>
      {t('hero.badge')}
    </Badge>
  </div>

  <HeroName />

  <div class="hero-body">
    <h2 class="hero-fade hero-role" style="--d:0">
      {t('hero.subtitle')}
    </h2>

    <p class="hero-fade hero-tagline" style="--d:1">
      {t('hero.tagline')}
    </p>

    <p class="hero-fade hero-description" style="--d:2">
      {t('hero.description')}
    </p>

    <div class="hero-fade hero-actions" style="--d:3">
      {
        /* The nav-link class and the data-section attribute make header.ts treat this button like
          a menu link: it smooth-scrolls to the projects section instead of loading a new page. */
      }
      <Button href={projectsUrl} data-section="proyectos" class="nav-link">
        {t('hero.cta-projects')}
      </Button>
      <Button
        href={cvUrl}
        download
        variant="glass"
        data-track="cv_download"
        data-track-cv-language={lang}
        data-track-location="hero"
      >
        <Icon slot="icon" name="tabler:download" size={24} />
        {t('hero.download-cv')}
      </Button>

      <SocialLinks class="hero-socials" linkClass="hero-social-link" location="hero" />
    </div>
  </div>
</div>

<style>
  .hero {
    padding-top: 2rem;
  }

  .hero-badge {
    margin-bottom: 1.25rem;
  }

  .hero-body {
    max-width: 60ch;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: 0;
    }

    /* Desktop cover screen: all the content is centered horizontally. */
    .hero {
      text-align: center;
    }

    .hero-badge {
      display: flex;
      justify-content: center;
    }

    .hero-body {
      max-width: 100%;
    }
  }

  .hero-role {
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--layer-text);
    margin-bottom: 0.25rem;
  }

  .hero-tagline {
    font-size: 1.0625rem;
    color: var(--layer-muted);
    margin-bottom: 0.75rem;
  }

  .hero-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--layer-muted);
    margin-bottom: 1.5rem;
  }

  /* On desktop the description is limited to about three lines so the hero fits in one screen. */
  @media (min-width: 1024px) {
    .hero-description {
      max-width: 60ch;
      margin-inline: auto;
      font-size: 0.875rem;
      line-height: 1.6;
    }
  }

  @media (min-width: 1440px) {
    .hero-description {
      font-size: 0.9375rem;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-actions :global(.hero-socials) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.5rem;
    list-style: none;
  }

  .hero-actions :global(.hero-social-link) {
    display: inline-flex;
    padding: 0.5rem;
    color: var(--layer-muted);
    transition: color 0.2s ease;
  }

  /* On desktop the social links are in the fixed left dock (SideDock), so they are hidden here. */
  @media (min-width: 1024px) {
    .hero-actions :global(.hero-socials) {
      display: none;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  .hero-actions :global(.hero-social-link:hover) {
    color: var(--layer-accent);
  }

  /* CSS-only intro: the badge and the body fade up (the name's letters rise in HeroName). It
     starts at first paint because it does not wait for JavaScript. Users who prefer reduced
     motion see everything at once. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-badge {
      animation: hero-badge-in 0.7s cubic-bezier(0.215, 0.61, 0.355, 1) both;
    }

    .hero-fade {
      animation: hero-fade-in 0.8s cubic-bezier(0.215, 0.61, 0.355, 1) both;
      /* Starts after the name's intro is mostly done; --d (0 to 3, set inline) staggers the
         elements by 100ms each. */
      animation-delay: calc(0.65s + var(--d, 0) * 0.1s);
    }

    @keyframes hero-badge-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }

    @keyframes hero-fade-in {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
    }
  }
</style>

<script>
  import { initHero } from '@components/sections/hero/hero';

  // Fires on the first load and after every client-side navigation (ClientRouter).
  document.addEventListener('astro:page-load', initHero);
</script>
