---
// The big name in the hero. It is split into lines, words and single characters while the page is
// built, so the intro animation is pure CSS and starts at first paint, without waiting for any
// JavaScript. `index` counts characters across all lines and sets each character's animation
// delay, which makes the letters appear one after another (a "stagger").
const nameLines = ['Juan David', 'Colonia'];
let charIndex = 0;
const nameWords = nameLines.map((line) =>
  line.split(' ').map((word) => [...word].map((char) => ({ char, index: charIndex++ })))
);
---

{/* The per-letter spans are hidden from screen readers; aria-label gives them the whole name. */}
<h1 class="hero-name" aria-label="Juan David Colonia">
  <span class="block" aria-hidden="true">
    {
      nameWords.map((words) => (
        <span class="block">
          {words.map((chars, wordIndex) => (
            <Fragment>
              <span class="hero-word">
                {chars.map(({ char, index }) => (
                  <span class="hero-char-mask">
                    <span class="hero-char" style={`--i:${index}`}>
                      {char}
                    </span>
                  </span>
                ))}
              </span>
              {wordIndex < words.length - 1 && ' '}
            </Fragment>
          ))}
        </span>
      ))
    }
  </span>
</h1>

<style>
  .hero-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.25rem, 8.2vw, 8rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--layer-text);
    margin-bottom: 1.25rem;
    will-change: transform, opacity;
  }

  @media (min-width: 1024px) {
    .hero-name {
      font-size: clamp(3.25rem, 9vw, 8.5rem);
    }
  }

  /* A word is never broken across lines. Each character sits inside a mask that clips it while
     it rises into place. */
  .hero-word {
    display: inline-block;
    white-space: nowrap;
  }

  /* Needed with and without animation: the generated markup has whitespace between the character
     spans. Inline spans would render it as gaps between letters; the inline blocks set here do not. */
  .hero-char-mask {
    display: inline-block;
  }

  /* CSS-only intro: the characters rise out of their masks, one after another. Users who prefer
     reduced motion see the name at once, with no animation. */
  @media (prefers-reduced-motion: no-preference) {
    /* The line-height is tight (1), so the tallest glyphs would be cut off by the mask's overflow
       clip. The padding gives them room, and the equal negative margin cancels it so the layout
       does not change. */
    .hero-char-mask {
      overflow: hidden;
      vertical-align: top;
      padding: 0.1em 0.05em;
      margin: -0.1em -0.05em;
    }

    .hero-char {
      display: inline-block;
      animation: hero-char-in 1s cubic-bezier(0.16, 1, 0.3, 1) both;
      /* 0.1s head start, then 30ms per character (--i is set inline in the markup). */
      animation-delay: calc(0.1s + var(--i) * 0.03s);
    }

    @keyframes hero-char-in {
      from {
        transform: translateY(120%);
      }
    }
  }
</style>
