---
/**
 * @file Language dropdown (ES/EN).
 *
 * Currently unused: the header imports it only in commented-out code while the selector is
 * disabled, and global.css excludes this file from the Tailwind scan so its utility classes stay
 * out of the bundle. Remove that exclusion when re-enabling it.
 */

import { languages } from '@i18n/ui';
import type { Lang } from '@data/types';
import { getLangFromUrl, stripBase } from '@i18n/utils';
import { localizePath } from '@lib/urls';

const pathWithoutBase = stripBase(Astro.url.pathname);
const currentLang = getLangFromUrl(Astro.url);
const isCv = /\/cv\/?$/.test(pathWithoutBase);
---

<div class="relative inline-block">
  <button
    id="lang-toggle"
    class="flex items-center gap-2 px-3 py-2 rounded-lg bg-gray-800 hover:bg-gray-700 transition-colors"
    aria-label="Cambiar idioma"
  >
    <span class="text-sm font-medium uppercase">{currentLang}</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  <div
    id="lang-menu"
    class="hidden absolute right-0 mt-2 w-32 rounded-lg bg-gray-800 shadow-lg border border-gray-700 overflow-hidden z-50"
  >
    {
      Object.entries(languages).map(([lang, label]) => {
        const href = localizePath(lang as Lang, isCv ? 'cv' : '');
        return (
          <a
            href={href}
            class={`block px-4 py-2 text-sm hover:bg-gray-700 transition-colors ${
              currentLang === lang ? 'bg-gray-700 font-medium' : ''
            }`}
          >
            {label}
          </a>
        );
      })
    }
  </div>
</div>

<script>
  // Wires up the dropdown. Runs after every client-side navigation (ClientRouter, Astro's
  // navigation without full page reloads), so it must not stack duplicate listeners.
  function initLanguagePicker() {
    const toggle = document.getElementById('lang-toggle');
    const menu = document.getElementById('lang-menu');

    if (!toggle || !menu) return;

    // Replace the button with a clone of itself: a clone carries no event listeners, which drops
    // any handler attached by an earlier run of this function.
    const newToggle = toggle.cloneNode(true) as HTMLElement;
    toggle.parentNode?.replaceChild(newToggle, toggle);

    // stopPropagation keeps this click from reaching the document-level "click outside" handler
    // below, which would close the menu again right after it opens.
    newToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });

    // Close the menu when the user clicks anywhere outside it.
    const clickOutside = (e: MouseEvent) => {
      if (!newToggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        menu.classList.add('hidden');
      }
    };

    document.addEventListener('click', clickOutside);

    // The listener is on `document`, which outlives page swaps, so remove it before the next page
    // replaces the DOM.
    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('click', clickOutside);
      },
      { once: true }
    );
  }

  // `astro:page-load` fires on the first load and after every client-side navigation.
  document.addEventListener('astro:page-load', initLanguagePicker);
</script>
