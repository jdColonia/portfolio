---
/**
 * @file Icon links for every entry in SOCIAL_LINKS.
 *
 * `class` and any other attribute (aria-label, ...) are applied to the <ul>.
 */

import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';
import { SOCIAL_LINKS } from '@data/config';

/** Props of the social links list; any other attribute is passed to the `<ul>`. */
interface Props extends HTMLAttributes<'ul'> {
  /** Class of each <a>. */
  linkClass?: string;
  /** Icon width and height in px. */
  size?: number;
  /**
   * Where the list is rendered (hero, dock...). When set, each link reports a `contact_click`
   * analytics event with this location; when omitted, the links are not tracked.
   */
  location?: string;
}

const { linkClass, size = 24, location, ...attrs } = Astro.props;
---

<ul {...attrs}>
  {
    SOCIAL_LINKS.map((link) => (
      <li>
        <a
          class={linkClass}
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.name}
          data-track={location ? 'contact_click' : undefined}
          data-track-method={location ? link.name.toLowerCase() : undefined}
          data-track-location={location}
        >
          <Icon name={link.icon} size={size} />
        </a>
      </li>
    ))
  }
</ul>
