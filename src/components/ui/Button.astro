---
// Pill-shaped call-to-action: solid orange ("primary") or translucent ("glass").
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'glass';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  /** Visual style: `primary` is a solid lava-orange fill, `glass` a flat translucent one. */
  variant?: Variant;
  /** Extra classes, merged with the variant class. */
  class?: string;
  /** Only used in the `<button>` form (when there is no `href`). */
  type?: 'button' | 'submit' | 'reset';
}

// Renders an <a> when an href is given and a <button> otherwise. Every other attribute (target,
// rel, download, data-*, aria-*, type) is passed straight to the element. The default slot is the
// label; the `icon` slot is placed before it.
const { variant = 'primary', class: className, href, ...attrs } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={[className, `btn-${variant}`]} {...attrs}>
  <slot name="icon" />
  <slot />
</Tag>

<style>
  .btn-primary,
  .btn-glass {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.375rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 600;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease;
  }

  .btn-primary {
    background: var(--color-lava);
    color: var(--color-coal);
  }

  .btn-primary:hover {
    background: var(--color-lava-400);
    transform: translateY(-2px);
  }

  /* Deliberately no backdrop-filter: blurring what is behind the button is expensive while the
     page scrolls, and a flat translucent fill looks good enough. */
  .btn-glass {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--layer-text);
  }

  .btn-glass:hover {
    transform: translateY(-2px);
  }
</style>
