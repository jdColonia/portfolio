---
// Wrapper for every section of the home page (and the plain CV page). On desktop each section
// fills one screen and the content sits beside a 3D "crystal" drawn by a fixed canvas behind the
// page. `data-layer` and `data-stage` are read by the scroll engine (src/lib/motion) to change
// the theme colour and move the crystal as this section scrolls into view.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  /**
   * Medallion layer of this section (raw, bronze, silver, gold or serve): the site's visual
   * theme, borrowed from data engineering. It selects the accent tint while the section is active.
   */
  layer?: string;
  /** Plain page section (e.g. the CV): no screen-sized layout and no crystal content zone. */
  plain?: boolean;
  /**
   * Desktop crystal stage for this section: where the crystal box sits. Content goes to the
   * opposite side (a crystal on the 'left' puts the content on the right), or is centered over a
   * dim crystal ('center'). 'none' hides the crystal and the content takes the full width between
   * the docks (the fixed side bars).
   */
  stage?: 'center' | 'left' | 'right' | 'none';
}

const { id, class: className, layer, plain = false, stage = 'right', ...rest } = Astro.props;
---

<section
  id={id}
  data-layer={layer}
  data-stage={stage}
  class:list={['section', { 'section-plain': plain }, className]}
  {...rest}
>
  <div class="section-content"><slot /></div>
</section>

<style>
  .section {
    width: 100%;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .section:not(.section-plain) {
    padding-block: 3rem;
  }

  .section-plain {
    max-width: 80rem;
  }

  @media (min-width: 768px) {
    .section {
      padding-inline: 1.5rem;
    }

    .section:not(.section-plain) {
      padding-block: 4rem;
    }
  }

  @media (min-width: 1024px) {
    .section-plain {
      padding-inline: 2rem;
    }

    /* Each section is one full screen, vertically centered. The 5.5rem (88px) top padding clears
       the fixed header; the side padding clears the docks. */
    .section:not(.section-plain) {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
      margin-inline: 0;
      padding: 5.5rem var(--dock-w) 2.5rem;
    }

    /* Content zone: about 55% of the viewport (--zone-w, defined in global.css); the crystal owns
       the other side. Stage 'right' (the default) keeps the content on the left; stage 'left'
       pushes it to the right edge. */
    .section:not(.section-plain) > .section-content {
      width: var(--zone-w);
      max-width: 100%;
    }

    .section[data-stage='left']:not(.section-plain) > .section-content {
      margin-left: auto;
    }

    /* Stage 'center': a centered cover screen with the crystal large and dim behind it. A soft
       dark gradient (the ::before below) keeps the text legible. The `isolation` rule makes the
       content its own stacking context, so the gradient's negative z-index puts it behind the
       text but still above the crystal canvas. */
    .section[data-stage='center']:not(.section-plain) > .section-content {
      position: relative;
      isolation: isolate;
      width: 100%;
      max-width: min(56rem, 100%);
      margin-inline: auto;
      text-align: center;
    }

    .section[data-stage='center']:not(.section-plain) > .section-content::before {
      content: '';
      position: absolute;
      inset: -10% -15%;
      z-index: -1;
      background: radial-gradient(closest-side, rgba(14, 16, 20, 0.7), transparent);
      pointer-events: none;
    }

    /* Wide centered sections (the stack section): room for three panels side by side. */
    .section.section-wide[data-stage='center']:not(.section-plain) > .section-content {
      max-width: min(72rem, 100%);
    }

    /* Stage 'none': the crystal is hidden, so the content spans everything between the docks. */
    .section[data-stage='none']:not(.section-plain) > .section-content {
      width: 100%;
    }

    /* The contact section shares its screen with the compact footer that follows it, so it is
       shorter by the footer's height. */
    .section.section-contact {
      min-height: calc(100svh - var(--footer-h));
    }

    /* The projects gallery is pinned (held in place while the page scrolls) and manages its own
       vertical padding. */
    .section.section-flush {
      padding-block: 0;
    }
  }
</style>
