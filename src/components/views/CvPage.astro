---
/**
 * @file The resume page: a PDF viewer plus download and open buttons.
 *
 * It is the single implementation behind both routes, pages/cv.astro (Spanish) and
 * pages/en/cv.astro (English); the language is read from the URL, which also picks which PDF is
 * shown.
 */

import { Icon } from 'astro-icon/components';
import Layout from '@layouts/Layout.astro';
import SectionContainer from '@components/ui/SectionContainer.astro';
import TitleSection from '@components/ui/TitleSection.astro';
import Button from '@components/ui/Button.astro';
import { SITE_CONFIG } from '@data/config';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { localizePath, withBase } from '@lib/urls';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cvFile = lang === 'es' ? SITE_CONFIG.cvEs : SITE_CONFIG.cvEn;
// The configured path starts with "/", so drop it to let withBase add the deployment base.
const cvUrl = withBase(cvFile.slice(1));
const homeUrl = localizePath(lang);
---

<Layout title={t('cv.meta-title')} description={t('cv.meta-description')}>
  <SectionContainer plain class="cv-section">
    <TitleSection as="h1" path="serve.cv">{t('cv.title')}</TitleSection>
    <p class="cv-lead">{t('cv.lead')}</p>

    {
      /*
      The two buttons appear twice on purpose: here, above the viewer (tablet and desktop), and
      again inside the fallback card below (phones). CSS shows only one of the two sets, see the
      media query in the style block. The data-track attributes feed the analytics events
      cv_download and cv_open (handled by the click listener in @lib/analytics).
    */
    }
    <div class="cv-actions cv-actions-top">
      <Button
        href={cvUrl}
        download
        data-track="cv_download"
        data-track-cv-language={lang}
        data-track-location="cv_page"
      >
        <Icon slot="icon" name="tabler:download" size={24} />
        {t('hero.download-cv')}
      </Button>
      <Button
        href={cvUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="glass"
        data-track="cv_open"
        data-track-cv-language={lang}
        data-track-location="cv_page"
      >
        {t('cv.open')}
      </Button>
    </div>

    <div class="cv-frame">
      <iframe src={cvUrl} title={t('cv.title')} class="cv-iframe"></iframe>

      {
        /* Phones: mobile browsers usually cannot render a PDF inside an iframe, so a card with the
          buttons replaces the viewer there. */
      }
      <div class="cv-fallback">
        <Icon name="tabler:file-cv" size={40} aria-hidden="true" />
        <p>{t('cv.fallback')}</p>
        <div class="cv-actions">
          <Button
            href={cvUrl}
            download
            data-track="cv_download"
            data-track-cv-language={lang}
            data-track-location="cv_page"
          >
            <Icon slot="icon" name="tabler:download" size={24} />
            {t('hero.download-cv')}
          </Button>
          <Button
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="glass"
            data-track="cv_open"
            data-track-cv-language={lang}
            data-track-location="cv_page"
          >
            {t('cv.open')}
          </Button>
        </div>
      </div>
    </div>

    <a href={homeUrl} class="cv-back">{t('cv.back')}</a>
  </SectionContainer>
</Layout>

<style>
  /* Top padding leaves room for the fixed site header. :global is needed because the class is
     applied to SectionContainer, a child component whose elements Astro does not scope here. */
  :global(.cv-section) {
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  .cv-lead {
    max-width: 60ch;
    margin-bottom: 1.5rem;
    font-size: 1.0625rem;
    color: var(--layer-muted);
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .cv-actions-top {
    margin-bottom: 1.5rem;
  }

  .cv-frame {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    background: rgba(14, 16, 20, 0.6);
  }

  /* Hidden below 768px (the fallback card is shown instead); see the media query further down. */
  .cv-iframe {
    display: none;
    width: 100%;
    height: min(80svh, 56rem);
    border: none;
  }

  .cv-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2.5rem 1.25rem;
    text-align: center;
    color: var(--layer-muted);
  }

  .cv-fallback .cv-actions {
    justify-content: center;
  }

  /* On phones the fallback card carries the buttons, so the row above the frame (which would
     repeat them) is hidden. The 768px media query below turns it back on. */
  .cv-actions-top {
    display: none;
  }

  @media (min-width: 768px) {
    .cv-iframe {
      display: block;
    }

    .cv-fallback {
      display: none;
    }

    .cv-actions-top {
      display: flex;
    }
  }

  .cv-back {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--layer-muted);
    transition: color 0.2s ease;
  }

  .cv-back:hover {
    color: var(--layer-accent);
  }
</style>
