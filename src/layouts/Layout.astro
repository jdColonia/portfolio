---
/**
 * @file Base layout wrapped around every page: the <head> (meta tags, fonts, canonical link, Google
 * Analytics), the page chrome (side dock, header, footer) and, when requested, the 3D crystal.
 *
 * It also starts the scroll engine (@lib/motion) and the analytics listeners. The site uses
 * ClientRouter (Astro's client-side navigation: the page is not reloaded), so those start on every
 * `astro:page-load` and the scroll engine is torn down on `astro:before-swap`.
 */

// Fonts: only the latin subsets are loaded, because the site is Spanish and English. Inter's
// @font-face lives in global.css instead.
// JetBrains Mono ships a single weight (400): the labels styled as 500 render with the 400 face,
// since the browser would otherwise fake a bold.
import '@fontsource/anton/latin-400.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import { ClientRouter } from 'astro:transitions';
import '@styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import antonLatin from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import Header from '@components/layout/header/Header.astro';
import Footer from '@components/layout/Footer.astro';
import DataCrystal from '@components/crystal/DataCrystal.astro';
import SideDock from '@components/layout/SideDock.astro';
import { getLangFromUrl } from '@i18n/utils';
import { localizePath, withBase } from '@lib/urls';

/** Props of the base layout; the page content goes in the default slot. */
interface Props {
  /** Page title, used in the `<title>` tag. */
  title: string;
  /** Meta description of the page. */
  description: string;
  /** Renders the 3D crystal behind the content. Only the home page uses it. */
  crystal?: boolean;
  /** 'home' points the canonical link at the language home (section routes duplicate it). */
  canonical?: 'home' | 'self';
}

const { title, description, crystal = false, canonical = 'self' } = Astro.props;

const lang = getLangFromUrl(Astro.url);

const faviconUrl = withBase('logo.svg');

const canonicalPath = canonical === 'home' ? localizePath(lang) : Astro.url.pathname;
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang} class="dark" data-stage={crystal ? 'center' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="generator" content={Astro.generator} />
    {
      /* Google Search Console ownership token (the site is also verified through Google Analytics). */
    }
    <meta name="google-site-verification" content="uIMl2BE9OG2ub7SdyI5z5KW5--UE-3IcrNtrpoTPQg8" />
    <title>{title}</title>
    <link rel="preload" as="font" type="font/woff2" crossorigin href={interLatin} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={antonLatin} />
    <slot name="head" />
    <ClientRouter />

    {
      /*
        The script below keeps the CSS custom property --vw on <html> equal to the viewport width
        without the scrollbar (100vw includes it). Full-bleed blocks use --vw so they never cause
        horizontal overflow. It is inline so the value exists before the first paint, and it
        writes --vw again after each router swap because the swap replaces the attributes of
        <html> and drops the inline style.
      */
    }
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var lastWidth = -1;
        var sync = function () {
          var width = root.clientWidth;
          if (width === lastWidth) return;
          lastWidth = width;
          root.style.setProperty('--vw', width + 'px');
        };
        sync();
        var force = function () {
          lastWidth = -1;
          sync();
        };
        if ('ResizeObserver' in window) new ResizeObserver(sync).observe(root);
        else window.addEventListener('resize', sync);
        document.addEventListener('astro:after-swap', force);
        window.addEventListener('load', sync);
        document.addEventListener('astro:page-load', force);
      })();
    </script>

    {
      /*
        Google Analytics (GA), in three pieces:

        1. A plain inline script that reads the `?interno=` query parameter. `?interno=1` stores a
           `ga_internal` flag in localStorage and `?interno=0` removes it. It runs on the main
           thread at parse time because header.ts rewrites the URL (dropping the query string)
           while the visitor scrolls through sections, which can happen before the Partytown worker
           starts. The flag lets the owner mark their own browser as internal traffic.
        2. The gtag.js loader.
        3. The gtag setup, which sends traffic_type=internal when the host is not the production
           one or when the flag is set. GA's "Internal Traffic" data filter then excludes those hits.

        Pieces 2 and 3 use type="text/partytown": Partytown runs third-party scripts in a web
        worker, so gtag.js (the heaviest script on the page) never blocks the main thread. These
        scripts run once per full page load, not on each ClientRouter navigation, so
        @lib/analytics sends the `page_view` events for client-side navigations itself. GA's own
        history-based page views are switched off in the GA admin, because header.ts changes the
        URL while the visitor scrolls through sections and they would inflate the count.
      */
    }
    <script is:inline>
      try {
        var interno = new URLSearchParams(location.search).get('interno');
        if (interno === '1') localStorage.setItem('ga_internal', '1');
        else if (interno === '0') localStorage.removeItem('ga_internal');
      } catch (e) {}
    </script>
    <script
      is:inline
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-W9MRJJPZG4"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() {
        dataLayer.push(arguments);
      };
      gtag('js', new Date());

      var internal = location.hostname !== 'jdcolonia.github.io';
      try {
        if (localStorage.getItem('ga_internal') === '1') internal = true;
      } catch (e) {}

      gtag('config', 'G-W9MRJJPZG4', internal ? { traffic_type: 'internal' } : {});
    </script>
  </head>

  <body class="relative min-h-screen font-sans">
    {crystal && <DataCrystal />}
    <SideDock />
    <Header />

    <main
      class:list={['relative z-10 overflow-x-clip', crystal ? 'main-zone' : 'lg:px-20 xl:px-24']}
    >
      <slot />
    </main>

    <div class="relative z-10"><Footer /></div>

    <style is:global>
      /* Native form controls and scrollbars render in their dark variant. */
      :root {
        color-scheme: dark;
      }

      /* Column layout so the footer stays at the bottom on short pages. `overscroll-behavior`
         removes the rubber-band bounce at the page edges. */
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
        overflow-x: hidden;
      }

      /* Reduced motion: effectively switch off CSS animations and transitions. The duration is
         0.01ms rather than 0 so that animationend/transitionend events still fire for any code
         waiting on them. */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>

    <script>
      import { initMotion, destroyMotion } from '@lib/motion';
      import { initAnalytics } from '@lib/analytics';

      // `astro:page-load` fires on the first load and after every client-side navigation;
      // `astro:before-swap` fires just before the old page is replaced, so the scroll engine can
      // clean up and be started again for the new page.
      document.addEventListener('astro:page-load', () => initMotion());
      document.addEventListener('astro:page-load', () => initAnalytics());
      document.addEventListener('astro:before-swap', () => destroyMotion());
    </script>
  </body>
</html>
